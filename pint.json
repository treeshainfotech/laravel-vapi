{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "final_class": true,
        "fully_qualified_strict_types": true,
        "ordered_class_elements": {
            "order": [
                "use_trait",
                "case",
                "constant_public",
                "constant_protected",
                "constant_private",
                "property_public",
                "property_protected",
                "property_private",
                "construct",
                "method_public_static",
                "method_public",
                "method_protected",
                "method_private",
                "destruct",
                "magic"
            ]
        },
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "strict_comparison": true,
        "strict_param": true
    }
}
